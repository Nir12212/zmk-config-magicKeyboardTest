#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp A       &kp C &kp D &kp E &kp F &kp G &kp H &kp I &kp J &kp K &kp L &kp M &kp N &kp V
                &kp P &kp O &kp Y &kp Z &kp X &kp Q &kp W &kp R &kp T &kp J &kp K &kp L &kp M &kp N 

            >;
        };
    };
};
